{
  "name": "AI Support Ticket Router",
  "nodes": [
    {
      "parameters": {
        "content": "## 🎫 AI Support Ticket Router\n\n**Flow:**\n1. Webhook receives support ticket\n2. Normalize & validate fields\n3. Claude AI classifies (billing / technical / general)\n4. Confidence check ≥ 70%\n5. Route to Slack channel\n6. Send Gmail auto-response\n7. Log to Google Sheets\n\n**Credentials to set up:**\n- Anthropic API\n- Slack Bot\n- Gmail OAuth2\n- Google Sheets OAuth2",
        "color": 2
      },
      "id": "7a550380-7f7f-4a13-b24e-f68648f6f024",
      "name": "Sticky Note ca22e19a",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1344,
        704
      ]
    },
    {
      "parameters": {
        "content": "## 🤖 AI Classification Node\n\nModel: Claude Sonnet 4.6\n\nOutput Schema:\n- category: billing | technical | general\n- confidence: 0.0-1.0\n- reasoning: string\n- priority: urgent | high | medium | low\n- suggestedResponse: string\n- keywords: string[]\n\nFallback: confidence < 0.7 → general queue + human review flag",
        "height": 200,
        "width": 300,
        "color": 3
      },
      "id": "dd7bb398-087e-46fe-8328-7bed52088c96",
