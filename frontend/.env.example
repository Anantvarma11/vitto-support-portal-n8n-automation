#
# Frontend → Backend API wiring
#
# Option A (direct): set this to your n8n production webhook URL:
#   https://<your-instance>.n8n.cloud/webhook/support-ticket
#
# Option B (recommended for CORS): use the Vite dev proxy
#   VITE_SUPPORT_TICKET_API_URL=/api/support-ticket
#   VITE_SUPPORT_TICKET_PROXY_TARGET=https://<your-instance>.n8n.cloud/webhook
#
VITE_SUPPORT_TICKET_API_URL=
VITE_SUPPORT_TICKET_PROXY_TARGET=

